raw `
EverGrandeCity_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, EverGrandeCity_OnTransition
	.byte 0

EverGrandeCity_OnTransition:
	call_if_set FLAG_SYS_WEATHER_CTRL, Common_EventScript_SetAbnormalWeather
	end

EverGrandeCity_EventScript_VictoryRoadSign::
	msgbox EverGrandeCity_Text_EnteringVictoryRoad, MSGBOX_SIGN
	end

EverGrandeCity_EventScript_CitySign::
	msgbox EverGrandeCity_Text_CitySign, MSGBOX_SIGN
	end

EverGrandeCity_EventScript_PokemonLeagueSign::
	msgbox EverGrandeCity_Text_EnteringPokemonLeague, MSGBOX_SIGN
	end

EverGrandeCity_EventScript_SetVisitedEverGrande::
	setflag FLAG_VISITED_EVER_GRANDE_CITY
	setvar VAR_TEMP_1, 1
	end

EverGrandeCity_Text_EnteringVictoryRoad:
	.string "ENTERING VICTORY ROAD$"

EverGrandeCity_Text_EnteringPokemonLeague:
	.string "ENTERING POKéMON LEAGUE\n"
	.string "CENTER GATE$"

EverGrandeCity_Text_CitySign:
	.string "EVER GRANDE CITY\p"
	.string "“The paradise of flowers, the sea,\n"
	.string "and POKéMON.”$"

`

script EverGrandeCity_EventScript_BorgesBattle {
    lock
    faceplayer
    trainerbattle_double(TRAINER_BORGES_EVERGRANDE, EverGrandeCity_Text_Borges_Intro, EverGrandeCity_Text_Borges_Outro, EverGrandeCity_Text_Borges_NotEnoughPokemons)
    msgbox(EverGrandeCity_Text_Borges_PostBattle, MSGBOX_AUTOCLOSE)
    waitmessage
    release
    end
}

text EverGrandeCity_Text_Borges_Intro {
    format("BORGES: Let's see if you are ready to challenge the POKéMON LEAGUE.")
}

text EverGrandeCity_Text_Borges_Outro {
    format("Seems like you are ready after all.")
}

text EverGrandeCity_Text_Borges_NotEnoughPokemons {
    format("BORGES: Come back when you have two or more POKéMON in your party.")
}

text EverGrandeCity_Text_Borges_PostBattle {
    format("BORGES: Good luck in the POKéMON LEAGUE.")
}

script EverGrandeCity_EventScript_Reshiram {
    lock
    msgbox(format("PREEEAAH!"))
    waitmessage
    release
    end
}

script EverGrandeCity_EventScript_CovasBattle {
    lock
    faceplayer
    trainerbattle_double(TRAINER_COVAS_EVERGRANDE, EverGrandeCity_Text_Covas_Intro, EverGrandeCity_Text_Covas_Outro, EverGrandeCity_Text_Covas_NotEnoughPokemons)
    msgbox(EverGrandeCity_Text_Covas_PostBattle, MSGBOX_AUTOCLOSE)
    waitmessage
    release
    end
}

text EverGrandeCity_Text_Covas_Intro {
    format("COVAS: Boa tarde.")
}

text EverGrandeCity_Text_Covas_Outro {
    format("COVAS: Fucking noob.")
}

text EverGrandeCity_Text_Covas_NotEnoughPokemons {
    format("COVAS: Pobre.")
}

text EverGrandeCity_Text_Covas_PostBattle {
    format("COVAS: Desampara-me a loja preto.")
}

script EverGrandeCity_EventScript_Rayquaza {
    lock
    msgbox(format("Kiyuryursheeah!"))
    waitmessage
    release
    end
}